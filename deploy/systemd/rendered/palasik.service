[Unit]
Description=PALASIK Edge Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=palasik
Group=palasik
WorkingDirectory=/opt/palasik
EnvironmentFile=/etc/palasik/palasik.env
ExecStartPre=/opt/palasik/.venv/bin/python -m palasik.cli.main check-startup --config /etc/palasik/config.yaml --host 0.0.0.0 --port 8080
ExecStart=/opt/palasik/.venv/bin/python -m palasik.cli.main serve-api --config /etc/palasik/config.yaml --host 0.0.0.0 --port 8080
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=20
StandardOutput=append:/var/log/palasik/palasik.log
StandardError=append:/var/log/palasik/palasik.log

[Install]
WantedBy=multi-user.target
