{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://notedavidrinaldi.github.io/palasik/schemas/policy-v2.schema.json",
  "title": "PALASIK Policy Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policy_id", "scope", "default_action", "rules"],
  "properties": {
    "version": {
      "anyOf": [
        { "const": "2" },
        { "const": 2 }
      ]
    },
    "policy_id": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "string",
      "enum": ["global", "building", "hospital", "factory", "port", "custom"]
    },
    "default_action": {
      "type": "string",
      "enum": ["ALLOW", "WARN", "QUARANTINE", "DENY", "BLOCK_ALARM"]
    },
    "description": { "type": ["string", "null"] },
    "version_meta": {
      "type": "object",
      "properties": {
        "created_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "lifecycle": {
          "type": "string",
          "enum": ["draft", "testing", "active", "archived"]
        }
      },
      "additionalProperties": true
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "priority", "conditions", "decision", "actions", "reason_code"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": ["string", "null"] },
          "enabled": { "type": "boolean", "default": true },
          "priority": { "type": "integer", "minimum": 0 },
          "risk_weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "effective_from": { "type": ["string", "null"], "format": "date-time" },
          "effective_to": { "type": ["string", "null"], "format": "date-time" },
          "conditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op", "key", "value"],
              "additionalProperties": false,
              "properties": {
                "op": {
                  "type": "string",
                  "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "nin", "contains", "exists"]
                },
                "key": { "type": "string", "minLength": 1 },
                "value": {
                  "type": ["string", "number", "boolean", "array", "object", "null"]
                }
              }
            }
          },
          "decision": {
            "type": "string",
            "enum": ["ALLOW", "WARN", "QUARANTINE", "DENY", "BLOCK_ALARM"]
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["notify_telegram", "notify_whatsapp", "relay_off", "plc_stop", "create_ticket", "quarantine_device", "none"]
            }
          },
          "reason_code": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
